// Prisma schema for Automation Project
// Database: MySQL
// Models: User, Task, TaskExecution, ExecutionLog

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           Task[]
  taskExecutions  TaskExecution[]
  assistantConversations AssistantConversation[]

  @@index([email])
  @@map("users")
}

// ─── Assistant Conversations ────────────────────────────────────────────────

model AssistantConversation {
  id        String   @id @default(uuid())
  userId    String
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId])
  @@index([updatedAt(sort: Desc)])
  @@map("assistant_conversations")
}

model AssistantMessage {
  id             String               @id @default(uuid())
  conversationId String
  role           AssistantMessageRole
  content        String               @db.Text
  metadata       Json?
  createdAt      DateTime             @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("assistant_messages")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?  @db.Text
  nodes       Json     // ReactFlow nodes array
  edges       Json     // ReactFlow edges array
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions TaskExecution[]

  @@index([userId])
  @@index([isActive])
  @@map("tasks")
}

// ─── Task Executions ─────────────────────────────────────────────────────────

model TaskExecution {
  id        String             @id @default(uuid())
  taskId    String
  userId    String
  status    ExecutionStatus    @default(PENDING)
  input     Json?              // Input data passed to execution
  output    Json?              // Output data from execution
  error     String?            @db.Text
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs  ExecutionLog[]

  @@index([taskId])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("task_executions")
}

// ─── Execution Logs ──────────────────────────────────────────────────────────

model ExecutionLog {
  id              String        @id @default(uuid())
  executionId     String
  level           LogLevel      @default(INFO)
  message         String        @db.Text
  nodeId          String?       // Which node generated this log
  nodeType        String?       // Type of node (log, http, script, etc.)
  metadata        Json?         // Additional context data
  timestamp       DateTime      @default(now())

  execution TaskExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
  @@index([level])
  @@index([timestamp(sort: Desc)])
  @@map("execution_logs")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum AssistantMessageRole {
  USER
  ASSISTANT
}
